[Unit]
Wants=gork-build.service
After=gork-build.service

[Container]
Pod=bots.pod
ContainerName=gork
Image=ghcr.io/machineonamission/gorkpy:main
AutoUpdate=registry
Pull=newer
Volume=/srv/volumes/bot/gork:/app/persist:z
# Point gork at the local Ollama OpenAI-compatible endpoint (server = this host, 192.168.0.2)
Environment=OLLAMA_HOST=http://192.168.0.2:11434
Environment=GORK_MODEL=qwen3:0.6b

[Service]
Restart=always
